[Unit]
Description=AgentDrone Developer Web Dashboard (Dev branch)
After=network.target

[Service]
Type=simple
User=snip
WorkingDirectory=/home/snip/AgentDrone-dev
Environment="PATH=/home/snip/AgentDrone/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/home/snip/AgentDrone-dev"
ExecStart=/home/snip/AgentDrone/.venv/bin/streamlit run src/ui/app.py --server.port 8502 --server.baseUrlPath dev --server.address 0.0.0.0 --server.headless true --server.enableCORS false --server.enableXsrfProtection false
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
