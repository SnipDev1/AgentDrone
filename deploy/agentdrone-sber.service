[Unit]
Description=AgentDrone Sber Design Web Dashboard (Role #3)
After=network.target

[Service]
Type=simple
User=snip
WorkingDirectory=/home/snip/AgentDrone
Environment="PATH=/home/snip/AgentDrone/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/home/snip/AgentDrone"
ExecStart=/home/snip/AgentDrone/.venv/bin/streamlit run src/ui/app.py --server.port 8501 --server.baseUrlPath sber --server.address 0.0.0.0 --server.headless true --server.enableCORS false --server.enableXsrfProtection false
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
