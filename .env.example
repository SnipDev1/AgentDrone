# AgentDrone Environment Configuration Template
# Copy this file to .env and adjust variables to match your local setup:
#   cp .env.example .env

# Path to the dataset folder.
# Can be a relative path (e.g. dataset, dataset/24.09.20206, data)
# or an absolute path (e.g. D:/Datasets/AgentDrone/24.09.20206 or /mnt/data/drone)
DATASET_DIR=dataset

# Public Yandex Disk link for downloading the dataset
YANDEX_DISK_PUBLIC_URL=https://disk.yandex.ru/d/_R6xYg1frCGW0w
